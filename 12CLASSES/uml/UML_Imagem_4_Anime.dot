digraph UML {
  graph [label="Imagem 4 - Penteados de anime", labelloc="t", fontsize=20, fontname="Arial", bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.6", splines="ortho"];
  node [shape=plaintext, fontname="Arial", fontsize=10];
  rankdir=TB;
  PenteadoCurto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#50627A" BGCOLOR="#FFFFFF">
<TR><TD BGCOLOR="#DCE8F5"><B>PenteadoCurto</B></TD></TR>
<HR/>
<TR><TD ALIGN="LEFT">- cor: String</TD></TR><TR><TD ALIGN="LEFT">- textura: String</TD></TR><TR><TD ALIGN="LEFT">- comprimentoCm: double</TD></TR>
<HR/>
<TR><TD ALIGN="LEFT">+ mudarCor(novaCor: String): void</TD></TR><TR><TD ALIGN="LEFT">+ classificarComprimento(): String</TD></TR><TR><TD ALIGN="LEFT">+ descricao(): String</TD></TR>
</TABLE>>];
  PenteadoLongo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#50627A" BGCOLOR="#FFFFFF">
<TR><TD BGCOLOR="#DCE8F5"><B>PenteadoLongo</B></TD></TR>
<HR/>
<TR><TD ALIGN="LEFT">- cor: String</TD></TR><TR><TD ALIGN="LEFT">- tipoFranja: String</TD></TR><TR><TD ALIGN="LEFT">- comprimentoCm: double</TD></TR>
<HR/>
<TR><TD ALIGN="LEFT">+ calcularComprimentoFinal(acrescimoCm: double): double</TD></TR><TR><TD ALIGN="LEFT">+ alterarFranja(novaFranja: String): void</TD></TR><TR><TD ALIGN="LEFT">+ descricao(): String</TD></TR>
</TABLE>>];
  PenteadoEspetado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#50627A" BGCOLOR="#FFFFFF">
<TR><TD BGCOLOR="#DCE8F5"><B>PenteadoEspetado</B></TD></TR>
<HR/>
<TR><TD ALIGN="LEFT">- cor: String</TD></TR><TR><TD ALIGN="LEFT">- alturaTopeteCm: double</TD></TR><TR><TD ALIGN="LEFT">- nivelDetalhe: int</TD></TR>
<HR/>
<TR><TD ALIGN="LEFT">+ ajustarTopete(novaAltura: double): void</TD></TR><TR><TD ALIGN="LEFT">+ calcularPontosDeDetalhe(): int</TD></TR><TR><TD ALIGN="LEFT">+ descricao(): String</TD></TR>
</TABLE>>];
  { rank=same; PenteadoCurto; PenteadoLongo; PenteadoEspetado; }
}

digraph UML {
  graph [label="Imagem 2 - Ciclismo em trilha", labelloc="t", fontsize=20, fontname="Arial", bgcolor="white", pad="0.25", nodesep="0.35", ranksep="0.6", splines="ortho"];
  node [shape=plaintext, fontname="Arial", fontsize=10];
  rankdir=TB;
  BicicletaTrilha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#50627A" BGCOLOR="#FFFFFF">
<TR><TD BGCOLOR="#DCE8F5"><B>BicicletaTrilha</B></TD></TR>
<HR/>
<TR><TD ALIGN="LEFT">- marca: String</TD></TR><TR><TD ALIGN="LEFT">- aro: int</TD></TR><TR><TD ALIGN="LEFT">- marchaAtual: int</TD></TR>
<HR/>
<TR><TD ALIGN="LEFT">+ trocarMarcha(novaMarcha: int): String</TD></TR><TR><TD ALIGN="LEFT">+ frear(): String</TD></TR><TR><TD ALIGN="LEFT">+ exibirDados(): String</TD></TR>
</TABLE>>];
  Ciclista [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#50627A" BGCOLOR="#FFFFFF">
<TR><TD BGCOLOR="#DCE8F5"><B>Ciclista</B></TD></TR>
<HR/>
<TR><TD ALIGN="LEFT">- nome: String</TD></TR><TR><TD ALIGN="LEFT">- idade: int</TD></TR><TR><TD ALIGN="LEFT">- nivel: String</TD></TR>
<HR/>
<TR><TD ALIGN="LEFT">+ pedalar(distanciaKm: double): String</TD></TR><TR><TD ALIGN="LEFT">+ avaliarExperiencia(): String</TD></TR><TR><TD ALIGN="LEFT">+ exibirFicha(): String</TD></TR>
</TABLE>>];
  Trilha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#50627A" BGCOLOR="#FFFFFF">
<TR><TD BGCOLOR="#DCE8F5"><B>Trilha</B></TD></TR>
<HR/>
<TR><TD ALIGN="LEFT">- nome: String</TD></TR><TR><TD ALIGN="LEFT">- distanciaKm: double</TD></TR><TR><TD ALIGN="LEFT">- dificuldade: String</TD></TR>
<HR/>
<TR><TD ALIGN="LEFT">+ calcularTempoEstimado(velocidadeMedia: double): double</TD></TR><TR><TD ALIGN="LEFT">+ exigeExperiencia(): boolean</TD></TR><TR><TD ALIGN="LEFT">+ exibirResumo(): String</TD></TR>
</TABLE>>];
  { rank=same; BicicletaTrilha; Ciclista; Trilha; }
}

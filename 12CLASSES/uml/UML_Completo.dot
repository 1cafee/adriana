digraph UML {
  graph [label="Visao geral - 12 classes organizadas por imagem", labelloc="t", fontsize=22, fontname="Arial", bgcolor="white", pad="0.25", nodesep="0.25", ranksep="0.65", splines="ortho", compound=true];
  node [shape=plaintext, fontname="Arial", fontsize=8];
  subgraph cluster1 { label="Imagem 1 - Loja"; color="#C7D3E0"; style="rounded";
    CamisaSocial [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#50627A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE8F5"><B>CamisaSocial</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- marca: String</TD></TR><TR><TD ALIGN="LEFT">- tamanho: String</TD></TR><TR><TD ALIGN="LEFT">- preco: double</TD></TR><HR/><TR><TD ALIGN="LEFT">+ calcularPrecoComDesconto(percentual: double): double</TD></TR><TR><TD ALIGN="LEFT">+ confereTamanho(tamanhoDesejado: String): boolean</TD></TR><TR><TD ALIGN="LEFT">+ gerarEtiqueta(): String</TD></TR></TABLE>>];
    CalcaSocial [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#50627A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE8F5"><B>CalcaSocial</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- marca: String</TD></TR><TR><TD ALIGN="LEFT">- tamanho: String</TD></TR><TR><TD ALIGN="LEFT">- preco: double</TD></TR><HR/><TR><TD ALIGN="LEFT">+ ajustarTamanho(novoTamanho: String): void</TD></TR><TR><TD ALIGN="LEFT">+ calcularValorComAjuste(custoAjuste: double): double</TD></TR><TR><TD ALIGN="LEFT">+ gerarEtiqueta(): String</TD></TR></TABLE>>];
    Terno [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#50627A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE8F5"><B>Terno</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- marca: String</TD></TR><TR><TD ALIGN="LEFT">- tamanho: String</TD></TR><TR><TD ALIGN="LEFT">- preco: double</TD></TR><HR/><TR><TD ALIGN="LEFT">+ calcularPrecoParcelado(parcelas: int): double</TD></TR><TR><TD ALIGN="LEFT">+ calcularPrecoComDesconto(percentual: double): double</TD></TR><TR><TD ALIGN="LEFT">+ gerarEtiqueta(): String</TD></TR></TABLE>>];
    { rank=same; CamisaSocial; CalcaSocial; Terno; }
  }
  subgraph cluster2 { label="Imagem 2 - Trilha"; color="#C7D3E0"; style="rounded";
    BicicletaTrilha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#50627A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE8F5"><B>BicicletaTrilha</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- marca: String</TD></TR><TR><TD ALIGN="LEFT">- aro: int</TD></TR><TR><TD ALIGN="LEFT">- marchaAtual: int</TD></TR><HR/><TR><TD ALIGN="LEFT">+ trocarMarcha(novaMarcha: int): String</TD></TR><TR><TD ALIGN="LEFT">+ frear(): String</TD></TR><TR><TD ALIGN="LEFT">+ exibirDados(): String</TD></TR></TABLE>>];
    Ciclista [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#50627A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE8F5"><B>Ciclista</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- nome: String</TD></TR><TR><TD ALIGN="LEFT">- idade: int</TD></TR><TR><TD ALIGN="LEFT">- nivel: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ pedalar(distanciaKm: double): String</TD></TR><TR><TD ALIGN="LEFT">+ avaliarExperiencia(): String</TD></TR><TR><TD ALIGN="LEFT">+ exibirFicha(): String</TD></TR></TABLE>>];
    Trilha [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#50627A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE8F5"><B>Trilha</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- nome: String</TD></TR><TR><TD ALIGN="LEFT">- distanciaKm: double</TD></TR><TR><TD ALIGN="LEFT">- dificuldade: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ calcularTempoEstimado(velocidadeMedia: double): double</TD></TR><TR><TD ALIGN="LEFT">+ exigeExperiencia(): boolean</TD></TR><TR><TD ALIGN="LEFT">+ exibirResumo(): String</TD></TR></TABLE>>];
    { rank=same; BicicletaTrilha; Ciclista; Trilha; }
  }
  subgraph cluster3 { label="Imagem 3 - Mascaras"; color="#C7D3E0"; style="rounded";
    MascaraMadeira [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#50627A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE8F5"><B>MascaraMadeira</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- origem: String</TD></TR><TR><TD ALIGN="LEFT">- tipoMadeira: String</TD></TR><TR><TD ALIGN="LEFT">- alturaCm: double</TD></TR><HR/><TR><TD ALIGN="LEFT">+ calcularAlturaEmMetros(): double</TD></TR><TR><TD ALIGN="LEFT">+ descreverMaterial(): String</TD></TR><TR><TD ALIGN="LEFT">+ mostrarFicha(): String</TD></TR></TABLE>>];
    MascaraPintada [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#50627A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE8F5"><B>MascaraPintada</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- corPrincipal: String</TD></TR><TR><TD ALIGN="LEFT">- estilo: String</TD></TR><TR><TD ALIGN="LEFT">- preco: double</TD></TR><HR/><TR><TD ALIGN="LEFT">+ alterarCor(novaCor: String): void</TD></TR><TR><TD ALIGN="LEFT">+ aplicarDesconto(percentual: double): double</TD></TR><TR><TD ALIGN="LEFT">+ mostrarFicha(): String</TD></TR></TABLE>>];
    MascaraCerimonial [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#50627A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE8F5"><B>MascaraCerimonial</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- nome: String</TD></TR><TR><TD ALIGN="LEFT">- finalidade: String</TD></TR><TR><TD ALIGN="LEFT">- estadoConservacao: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+ atualizarConservacao(novoEstado: String): void</TD></TR><TR><TD ALIGN="LEFT">+ estaBemConservada(): boolean</TD></TR><TR><TD ALIGN="LEFT">+ mostrarFicha(): String</TD></TR></TABLE>>];
    { rank=same; MascaraMadeira; MascaraPintada; MascaraCerimonial; }
  }
  subgraph cluster4 { label="Imagem 4 - Anime"; color="#C7D3E0"; style="rounded";
    PenteadoCurto [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#50627A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE8F5"><B>PenteadoCurto</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- cor: String</TD></TR><TR><TD ALIGN="LEFT">- textura: String</TD></TR><TR><TD ALIGN="LEFT">- comprimentoCm: double</TD></TR><HR/><TR><TD ALIGN="LEFT">+ mudarCor(novaCor: String): void</TD></TR><TR><TD ALIGN="LEFT">+ classificarComprimento(): String</TD></TR><TR><TD ALIGN="LEFT">+ descricao(): String</TD></TR></TABLE>>];
    PenteadoLongo [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#50627A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE8F5"><B>PenteadoLongo</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- cor: String</TD></TR><TR><TD ALIGN="LEFT">- tipoFranja: String</TD></TR><TR><TD ALIGN="LEFT">- comprimentoCm: double</TD></TR><HR/><TR><TD ALIGN="LEFT">+ calcularComprimentoFinal(acrescimoCm: double): double</TD></TR><TR><TD ALIGN="LEFT">+ alterarFranja(novaFranja: String): void</TD></TR><TR><TD ALIGN="LEFT">+ descricao(): String</TD></TR></TABLE>>];
    PenteadoEspetado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#50627A" BGCOLOR="#FFFFFF"><TR><TD BGCOLOR="#DCE8F5"><B>PenteadoEspetado</B></TD></TR><HR/><TR><TD ALIGN="LEFT">- cor: String</TD></TR><TR><TD ALIGN="LEFT">- alturaTopeteCm: double</TD></TR><TR><TD ALIGN="LEFT">- nivelDetalhe: int</TD></TR><HR/><TR><TD ALIGN="LEFT">+ ajustarTopete(novaAltura: double): void</TD></TR><TR><TD ALIGN="LEFT">+ calcularPontosDeDetalhe(): int</TD></TR><TR><TD ALIGN="LEFT">+ descricao(): String</TD></TR></TABLE>>];
    { rank=same; PenteadoCurto; PenteadoLongo; PenteadoEspetado; }
  }
}
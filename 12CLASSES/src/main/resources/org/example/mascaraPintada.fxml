<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.MascaraPintadaController">
    <children>
        <Label layoutX="250.0" layoutY="22.0" text="Máscara Pintada" />
        <Label layoutX="95.0" layoutY="56.0" text="Preencha os campos e clique em Calcular:" />
        <Label layoutX="62.0" layoutY="97.0" prefWidth="130.0" text="Cor principal:" />
        <TextField fx:id="corPrincipalField" layoutX="190.0" layoutY="92.0" prefWidth="320.0" promptText="Digite cor principal" />
        <Label layoutX="62.0" layoutY="137.0" prefWidth="130.0" text="Estilo:" />
        <TextField fx:id="estiloField" layoutX="190.0" layoutY="132.0" prefWidth="320.0" promptText="Digite estilo" />
        <Label layoutX="62.0" layoutY="177.0" prefWidth="130.0" text="Preço (R$):" />
        <TextField fx:id="precoField" layoutX="190.0" layoutY="172.0" prefWidth="320.0" promptText="Digite preço (r$)" />
        <Button layoutX="239.0" layoutY="218.0" prefHeight="35.0" prefWidth="122.0" onAction="#executar" text="Calcular" />
        <Label fx:id="resultadoLabel" layoutX="60.0" layoutY="265.0" prefHeight="65.0" prefWidth="480.0" text="O resultado aparecerá aqui." wrapText="true" />
        <Button layoutX="239.0" layoutY="340.0" prefHeight="35.0" prefWidth="122.0" onAction="#voltar" text="Voltar" />
    </children>
</AnchorPane>
